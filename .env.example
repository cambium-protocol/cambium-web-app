# Optional: on-chain event indexer tuning.
# How many recent ledgers to scan for protocol events (retirements, project
# registrations, transfers). Higher values cover more history at the cost of
# RPC round-trips; the app degrades gracefully when events fall outside it.
NEXT_PUBLIC_CHAIN_INDEX_WINDOW=200000
# Optional: force the scan to start at a specific ledger (e.g. the ledger
# right after your contracts were deployed). Defaults to the ledger the RPC
# provider still serves.
NEXT_PUBLIC_CHAIN_INDEX_START_LEDGER=
